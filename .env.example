# 비공개 매장 입장 코드 (손님에게 공유하는 코드)
SITE_ACCESS_CODE=change-me

# 쿠키에 저장되는 비밀 토큰 (긴 무작위 문자열로 직접 생성해서 넣으세요, 노출 금지)
SITE_ACCESS_TOKEN=change-me-too

# Neon Postgres 연결 문자열 (Neon 콘솔 → Connection string, "-pooler" 포함된 것 권장)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# 관리자 로그인 (1인 관리자용)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_TOKEN=random-long-secret-string

# Cloudflare R2 (상품/카테고리 이미지 저장)
# Cloudflare 대시보드 > R2 Object Storage 에서 발급
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=furniture-shop-images
# 버킷의 Public Development URL (예: https://pub-xxxxxxxxxxxx.r2.dev)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
